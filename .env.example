# ============================================================================
# EMPLOYEE PRODUCTIVITY ANALYST AGENT - CONFIGURATION (.env)
# ============================================================================

# 1. GOOGLE GEMINI API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 2. DATA MODE ("auto" uses live API as soon as credentials are provided, otherwise uses realistic sample data)
USE_MOCK_DATA=auto

# 3. AZURE DEVOPS (Commits & Pull Requests)
ADO_ORG_URL=https://dev.azure.com/proglint
ADO_PROJECT=
ADO_PAT=

# 4. OUTLOOK CALENDAR (Microsoft Graph API)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
